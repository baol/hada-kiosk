<?xml version="1.0" encoding="utf-8"?>
<!-- Version, minSdk and targetSdk are set by scripts/build-apk.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.baol.hada">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="hada"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:allowBackup="false">

        <!-- The dashboard: native code (libhada_android.so) drawing with Slint. -->
        <activity
            android:name="android.app.NativeActivity"
            android:label="hada"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|uiMode|density|navigation"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="hada_android" />
            <!-- From the app drawer. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Offered as Home app: choose hada (Always) for a wall panel. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="io.github.baol.hada.PrefsActivity"
            android:label="hada"
            android:theme="@android:style/Theme.Material"
            android:exported="false" />

        <receiver android:name="io.github.baol.hada.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
