// Dark theme tokens (close to Home Assistant's default dark theme).
export global Theme {
    out property <color> bg: #0f1115;
    out property <color> rail: #141720;
    out property <color> card: #1b1f27;
    out property <color> card-raised: #242a35;
    out property <color> pressed: #2d3442;
    out property <color> text: #e9ebf0;
    out property <color> text-dim: #9aa1ae;
    out property <color> text-faint: #5f6675;
    out property <color> accent: #ffb300;     // active icon (amber)
    out property <color> primary: #2d9cdb;    // toggles / sliders
    out property <color> ok: #43a047;
    out property <color> warn: #fbc02d;
    out property <color> danger: #e53935;
    out property <color> divider: #2b303b;
    out property <color> track: #343a47;
    out property <length> radius: 12px;
    out property <length> pad: 12px;
    out property <length> gap: 8px;
    out property <length> row-h: 48px;
    out property <length> section-row: 56px;
    out property <length> font-s: 13px;
    out property <length> font-m: 15px;
    out property <length> font-l: 18px;
    out property <length> font-xl: 30px;
}
